# .env.example — single shared env file at the repo root.
# Copy to `.env` and fill in the values. Every process loads it from here:
#   - API + workers via @dubbercut/env (packages/env)
#   - web app via Vite envDir (apps/web/vite.config.ts)
#   - prisma via dotenv-cli (apps/api db:* scripts)
# Machine-local overrides go in `.env.local` (also gitignored).
#
# Required for `pnpm check-env`:
#   DATABASE_URL, AUTH_SECRET, and (GEMINI_API_KEY or HF_TOKEN)
# OPENAI_API_KEY is needed for Whisper transcription; Anthropic is optional
# when HF_TOKEN is set (auto-cut falls back to Hugging Face chat).

# ── AI (server-side only — never expose to the browser) ──────────
# Clients call /api/ai/*; only the API and ai-worker read these keys.

# Google AI Studio / Gemini — chat (translate, summarize, chapters…) + TTS
# Get a key: https://aistudio.google.com/apikey
# Optional when HF_TOKEN is set (HF used as LLM/TTS fallback).
GEMINI_API_KEY=

# OpenAI — Whisper speech-to-text (dubbing / autocut transcription)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude for auto-cut and agent-cut planning
# Get a key: https://console.anthropic.com/settings/keys
# Optional when HF_TOKEN is set.
ANTHROPIC_API_KEY=

# Hugging Face — LLM + TTS fallback when Gemini/Anthropic keys are unset
# Get a token (Inference Providers permission): https://huggingface.co/settings/tokens
#HF_TOKEN=
# Optional HF model overrides
#HF_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
#HF_TTS_MODEL=facebook/mms-tts-eng
#HF_TRANSCRIBE_MODEL=openai/whisper-large-v3
# Comma-separated fallbacks if the primary chat model isn't enabled for your token
#HF_CHAT_MODEL_FALLBACKS=Qwen/Qwen3-8B,google/gemma-3-4b-it,openai/gpt-oss-20b,meta-llama/Llama-3.1-8B-Instruct
#HF_ROUTER_BASE_URL=https://router.huggingface.co
# Per-request timeout for HF calls (cold starts can be slow); default 120000
#HF_REQUEST_TIMEOUT_MS=120000

# Optional provider model overrides (defaults shown)
#AI_CHAT_MODEL=gemini-2.5-flash
#AI_TRANSCRIBE_MODEL=whisper-1
# Chunked STT: split audio into N-second slices, run up to M in parallel
#AI_TRANSCRIBE_CHUNK_SECONDS=30
#AI_TRANSCRIBE_CONCURRENCY=3
#AI_TTS_MODEL=gemini-2.5-flash-preview-tts
#AI_AUTOCUT_MODEL=claude-sonnet-4-5-20250929
#AI_AGENT_CUT_MODEL=claude-opus-4-20250514
# Optional base URL overrides (rarely needed)
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com
#OPENAI_BASE_URL=https://api.openai.com
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Freesound.org — Sounds panel search (API proxies /api/sounds/search)
# Apply: https://freesound.org/apiv2/apply
#FREESOUND_API_KEY=

# ── API server (apps/api) ───────────────────────────────────────
# MongoDB connection string — include a database name in the path.
# Atlas: https://cloud.mongodb.com → Connect → Drivers
# Local docker-compose overrides this to mongodb://mongo:27017/...
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dubbercut?retryWrites=true&w=majority"

# JWT signing secret for auth tokens — generate with: openssl rand -base64 32
AUTH_SECRET=

# API listen port (default 4000)
#PORT=4000

# Optional: Redis cache (API falls back to DB when unset or down)
#REDIS_URL="redis://localhost:6379"

# Optional: RabbitMQ job events (workers poll /api/jobs/claim when unset)
#RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ── Upload storage ──────────────────────────────────────────────
# Cloudflare R2 (S3-compatible). When all four R2_* vars are set the API
# stores uploads in R2; otherwise files go to local disk (UPLOAD_DIR).
# Dashboard: https://dash.cloudflare.com → R2
#R2_ACCOUNT_ID=
#R2_BUCKET=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
# Optional: public bucket or custom domain — downloads redirect here
# instead of using presigned URLs.
#R2_PUBLIC_URL=https://media.example.com
# Presigned URL lifetime in seconds (default 3600)
#R2_SIGNED_URL_TTL=3600
# Force a driver explicitly: r2 | local
#STORAGE_DRIVER=local
#UPLOAD_DIR=./uploads

# ── Workers (services/*) ────────────────────────────────────────
# Base URL workers use to reach the API (docker-compose sets http://api:4000)
#API_URL=http://localhost:4000
# How often workers poll for jobs when RabbitMQ is unset (default 3000)
#POLL_INTERVAL_MS=3000

# ── Web client (apps/web) ───────────────────────────────────────
# Browser → API base URL (must be reachable from the host machine)
#VITE_API_URL=http://localhost:4000
